    "/api/wallet/balances": {
      "post": {
        "summary": "Query real live on-chain TESTNET native (NEAR, ETH, SOL, BTC, SUI, TON, XRP) and stablecoin (USDC, USDT) balances via Testnet RPCs (Rule Q-010) and flag Mainnet mismatches",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "address"
                ],
                "properties": {
                  "address": {
                    "type": "string",
                    "description": "Connected NEAR Testnet, EVM Sepolia 0x, Solana Testnet/Devnet, Bitcoin Testnet (tb1...), Sui Testnet 0x, TON Testnet, or XRPL Testnet address"
                  },
                  "chainType": {
                    "type": "string",
                    "enum": [
                      "near",
                      "evm",
                      "solana",
                      "bitcoin",
                      "sui",
                      "ton",
                      "xrp"
                    ],
                    "description": "Wallet network family (defaults to near)"
                  },
                  "chainIdHex": {
                    "type": "string",
                    "description": "Optional active EVM chainId hex (0xaa36a7 Sepolia, 0x14a34 Base Sepolia, 0x66eee Arbitrum Sepolia)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Live Testnet native and token balance snapshot (0 when empty; isMainnetMismatch=true if Mainnet)"
          },
          "400": {
            "description": "Missing or malformed wallet address"
          }
        }
      }
    }
