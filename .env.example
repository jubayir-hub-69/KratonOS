# ============================================================================
# KratonOS — NEAR Hackathon 2026 Environment Configuration (.env.example)
# Safe defaults configured for zero-config AI judge & sandbox verification.
# Copy to `.env` for local runs. NEVER commit `.env` or real private keys.
# ============================================================================

# --- NEAR Network & Account Configuration ---
NEAR_NETWORK_ID=testnet
NEAR_ACCOUNT_ID=jubayir69.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_MAINNET_RPC_URL=https://rpc.mainnet.near.org
NEAR_PRIVATE_KEY=

# --- NEAR Intents 1Click API (Confidential Cross-Chain Execution) ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=
ONECLICK_EXPLORER_API_KEY=
PROTOCOL_FEE_RECIPIENT=jubayir33.near

# --- NEAR AI Cloud (TEE Hardware-Attested Inference) ---
NEARAI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_CLOUD_API_KEY=
NEARAI_MODEL=zai-org/GLM-5.1-FP8

# --- NEAR AI Agent Market (A2A + x402 Autonomous Commerce) ---
AGENT_MARKET_BASE_URL=https://market.near.ai
AGENT_MARKET_API_TOKEN=

# --- OutLayer Confidential WASI P1/P2 Enclave Contracts ---
OUTLAYER_CONTRACT_ID=outlayer.testnet
OUTLAYER_WORKER_CONTRACT_ID=worker.outlayer.testnet

# --- RHEA Finance (DeFi AMM & Farming on NEAR) ---
RHEA_EXCHANGE_CONTRACT_ID=ref-finance.testnet
RHEA_FARMING_CONTRACT_ID=ref-farming.testnet

# --- Governance & Chain Signatures ---
SPUTNIK_DAO_CONTRACT_ID=kratonos-dao.sputnikv2.testnet
MPC_SIGNER_CONTRACT_ID=v1.signer-prod.testnet

