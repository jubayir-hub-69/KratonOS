{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/ui",
  "functions": {
    "api/index.ts": {
      "includeFiles": "{config.yaml,samples/**,contracts/**,enclave/**,dist/ui/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/llms.txt", "destination": "/api/index" },
    { "source": "/openapi.json", "destination": "/api/index" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/(.*)", "destination": "/index.html" },
    { "source": "/((?!api/|assets/|llms\\.txt|openapi\\.json).*)", "destination": "/index.html" }
  ]
}
