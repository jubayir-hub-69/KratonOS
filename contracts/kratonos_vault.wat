  (func (export "harvest_yield_sweep")
    (local $input_len i64)
    (local $total_log_len i64)
    (local $end_ptr i32)
    (local $promise_id i64)
    (local $scan_ptr i32)
    (local $quote_count i32)
    (local $acct_ptr i64)
    (local $acct_len i64)
    (call $input (i64.const 0))
    (call $predecessor_account_id (i64.const 1))
    (drop (call $block_height))
    (local.set $input_len (call $register_len (i64.const 0)))
    (if (i64.gt_u (local.get $input_len) (i64.const 0))
      (then
        (call $read_register (i64.const 0) (i64.const 8307))
        (local.set $end_ptr (i32.add (i32.const 8307) (i32.wrap_i64 (local.get $input_len))))
        (i32.store8 (local.get $end_ptr) (i32.const 125))
        (local.set $total_log_len (i64.add (i64.const 116) (local.get $input_len)))
      )
      (else
        (i32.store8 (i32.const 8307) (i32.const 123))
        (i32.store8 (i32.const 8308) (i32.const 125))
        (i32.store8 (i32.const 8309) (i32.const 125))
        (local.set $total_log_len (i64.const 118))
      )
    )
    (drop (call $storage_write (i64.const 12) (i64.const 1260) (i64.sub (local.get $total_log_len) (i64.const 11)) (i64.const 8203) (i64.const 2)))
    (call $log_utf8 (local.get $total_log_len) (i64.const 8192))
    (local.set $acct_ptr (i64.const 256))
    (local.set $acct_len (i64.const 0))
    (if (i32.ge_u (local.get $end_ptr) (i32.const 8307))
      (then
        (local.set $scan_ptr (i32.const 8307))
        (local.set $quote_count (i32.const 0))
        (block $break
          (loop $continue
            (br_if $break (i32.ge_u (local.get $scan_ptr) (local.get $end_ptr)))
            (if (i32.eq (i32.load8_u (local.get $scan_ptr)) (i32.const 34))
              (then
                (local.set $quote_count (i32.add (local.get $quote_count) (i32.const 1)))
                (if (i32.eq (local.get $quote_count) (i32.const 3))
                  (then (local.set $acct_ptr (i64.extend_i32_u (i32.add (local.get $scan_ptr) (i32.const 1)))))
                )
                (if (i32.eq (local.get $quote_count) (i32.const 4))
                  (then
                    (local.set $acct_len (i64.sub (i64.extend_i32_u (local.get $scan_ptr)) (local.get $acct_ptr)))
                    (br $break)
                  )
                )
              )
            )
            (local.set $scan_ptr (i32.add (local.get $scan_ptr) (i32.const 1)))
            (br $continue)
          )
        )
      )
    )
    (if (i64.eqz (local.get $acct_len))
      (then
        (local.set $acct_ptr (i64.const 256))
        (local.set $acct_len (i64.const 14))
      )
    )
    (call $attached_deposit (i64.const 432))
    (if (i64.ne (i64.or (i64.load (i32.const 432)) (i64.load (i32.const 440))) (i64.const 0))
      (then
        (local.set $promise_id (call $promise_batch_create (local.get $acct_len) (local.get $acct_ptr)))
        (call $promise_batch_action_transfer (local.get $promise_id) (i64.const 432))
      )
    )
    (call $value_return (i64.sub (local.get $total_log_len) (i64.const 11)) (i64.const 8203))
  )

